{
  "name": "dsh-api-usage-dashboard",
  "version": "1.0.0",
  "description": "DSH (DeepSeek Harness) plugin: a zero-config API usage dashboard — 24-hour bar chart, per-day drill-down, per-provider and per-model colors, aggregated from local session logs.",
  "type": "module",
  "license": "MIT",
  "author": "LENS-Views",
  "contributors": [
    {
      "name": "DSH Agent (deepseek-flash)",
      "url": "https://github.com/deepseek-ai/deepseek-harness"
    }
  ],
  "homepage": "https://github.com/LENS-Views/dsh-api-usage-dashboard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LENS-Views/dsh-api-usage-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/LENS-Views/dsh-api-usage-dashboard/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "deepseek-usage",
    "token-usage",
    "api-usage",
    "usage-dashboard",
    "usage-statistics",
    "llm-observability",
    "dashboard",
    "tokens",
    "cordis"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
